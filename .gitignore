node_modules/
dist/
*.log
.DS_Store
.env
.env.local
.vercel
packages/design-system/package-lock.json

# Root-level Playwright tooling installed by demo verification scripts.
# Not part of the shipped design-docs site; keep out of version control.
/package.json
/package-lock.json

# Pagefind static search index — generated by scripts/build-search.sh
# (or `npx pagefind --site . --output-path _pagefind`). Re-built at
# deploy time and served as part of the published site, but not tracked
# in git so source changes stay legible.
/_pagefind/

# Generated visual regression baselines (PNG) — produced by
# scripts/visual-baseline.mjs. Treated as build artefacts; the
# GitHub Actions workflow regenerates them on demand.
/visual-baselines/*.png

# Seeded design-canvas output — rebuilt from .canvas/*.dc.html by seed-canvas.mjs
.canvas/corelith-system.html
