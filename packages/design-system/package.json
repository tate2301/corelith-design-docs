{
  "name": "@corelith/design-system",
  "version": "0.1.0",
  "description": "Huchu Design System — React primitives, blocks, shells, and patterns. Next.js compatible.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "src", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "require": "./dist/primitives/index.cjs"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js",
      "require": "./dist/blocks/index.cjs"
    },
    "./shells": {
      "types": "./dist/shells/index.d.ts",
      "import": "./dist/shells/index.js",
      "require": "./dist/shells/index.cjs"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.js",
      "require": "./dist/patterns/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:css": "node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "sideEffects": ["**/*.css"],
  "keywords": ["design-system", "react", "nextjs", "ui", "components", "huchu", "corelith"],
  "repository": {
    "type": "git",
    "url": "https://github.com/tate2301/corelith-design-docs"
  },
  "publishConfig": {
    "access": "public"
  }
}
