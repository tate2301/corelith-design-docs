{
  "name": "@corelithzw/react",
  "version": "0.3.4",
  "description": "Corelith React primitives — thin JSX wrappers over the Corelith design-system CSS.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "src", "README.md", "CHANGELOG.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./cdn.global.js": "./dist/cdn.global.js"
  },
  "sideEffects": ["**/*.css"],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tate2301/corelith-design-docs.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/tate2301/corelith-design-docs/issues"
  },
  "homepage": "https://github.com/tate2301/corelith-design-docs",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.config.cdn.ts && node scripts/bundle-css.mjs",
    "build:lib": "vite build",
    "build:cdn": "vite build --config vite.config.cdn.ts",
    "build:css": "node scripts/bundle-css.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["corelith", "react", "design-system", "ui", "components"],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
