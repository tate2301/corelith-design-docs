{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@corelithzw/react": ["../packages/react/src/index.ts"],
      "react": ["../packages/react/node_modules/@types/react/index.d.ts"],
      "react/*": ["../packages/react/node_modules/@types/react/*"],
      "react-dom": ["../packages/react/node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["../packages/react/node_modules/@types/react-dom/*"]
    },
    "typeRoots": [
      "../packages/react/node_modules/@types"
    ]
  },
  "include": ["/tmp/snippet-check/**/*.tsx"]
}
